FUNCTION_BLOCK "MediaMovil"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
   VAR_INPUT 
      In : Real;
      N : Int;
   END_VAR

   VAR_OUTPUT 
      Out : Real;
   END_VAR

   VAR 
      buffer : Array[1..100] of Real;
      index : Int := 1;
      sum : Real := 0.0;
   END_VAR


BEGIN
	    REGION "Media Movil Calculation"
	        #sum := #sum - #buffer[#index] + #In;
	        #buffer[#index] := #In;
	        #index := #index + 1;
	        IF #index > #N THEN
	            #index := 1;
	        END_IF;
	        #Out := #sum / #N;
	    END_REGION
END_FUNCTION_BLOCK

